<h1>Lista productos</h1>

<ul>
    {{#each products}}
        <li>
        <p>{{this.title}}</p>
        <p>{{this.price}}</p>
        </li>
    {{/each}}
</ul>

{{! Paginación }}

<div>
    {{#if hasPrevPage}}
        <a href="/products?page={{prevPage}}">Anterior</a>
    {{/if}}

    <span>Página {{page}} de {{totalPages}}</span>

    {{#if hasNextPage}}
        <a href="/products?page={{nextPage}}">Siguiente</a>
    {{/if}}
</div>